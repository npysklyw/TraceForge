# Local development only. Do not use these credentials in production.
BENCHWARDEN_POSTGRES_USER=benchwarden
BENCHWARDEN_POSTGRES_PASSWORD=benchwarden
BENCHWARDEN_POSTGRES_DB=benchwarden
BENCHWARDEN_POSTGRES_PORT=5432
BENCHWARDEN_BACKEND_PORT=8000
BENCHWARDEN_FRONTEND_PORT=5173
# Existing installations: set this to the existing PostgreSQL volume name.
BENCHWARDEN_POSTGRES_VOLUME=benchwarden_postgres_data
